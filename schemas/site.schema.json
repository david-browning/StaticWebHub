{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "defaultLocale": {
      "type": "string"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "homePage": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "displayName",
          "homePage"
        ]
      }
    }
  },
  "required": [
    "title",
    "defaultLocale",
    "locales"
  ]
}