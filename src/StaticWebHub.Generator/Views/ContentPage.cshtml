@model StaticWebHub.Generator.Models.ContentPage
@{
	Layout = "/Views/Shared/_BasicPageLayout.cshtml";
}

<header class="site-header">
	<div class="shell">
		<div class="page-type">Content</div>
		<h1>@Model.Title</h1>
		@if (!string.IsNullOrWhiteSpace(Model.Subtitle))
		{
			<p class="subtitle">
				@Model.Subtitle
			</p>
		}
	</div>
</header>

<main class="shell page-content">
	@if (!string.IsNullOrWhiteSpace(Model.Description))
	{
		<p class="page-description">
			@Model.Description
		</p>
	}

	<article class="content-document">
		@Html.Raw(Model.RenderedContent)
	</article>
</main>