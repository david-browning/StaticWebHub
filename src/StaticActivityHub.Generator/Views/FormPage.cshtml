@model StaticActivityHub.Generator.Models.FormPage
@using StaticActivityHub.Generator.Models

<!DOCTYPE html>
<html lang="@Model.Locale">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@Model.Title</title>
	<link rel="stylesheet" href="/assets/site.css" />
</head>
<body>

	<header class="site-header">
		<div class="shell">
			<div class="page-type">Form</div>
			<h1>@Model.Title</h1>
			@if (!string.IsNullOrWhiteSpace(Model.Subtitle))
			{
				<p class="subtitle">
					@Model.Subtitle
				</p>
			}
		</div>
	</header>

	<main class="shell page-content">
		@if (!string.IsNullOrWhiteSpace(Model.Description))
		{
			<p class="page-description">
				@Model.Description
			</p>
		}

		<form id="generated-form" class="generated-form" data-submit-url="@Model.SubmitUrl">
			@foreach (var field in Model.Fields)
			{
				<div class="form-field">
					@if (field.Type != FormFieldType.Checkbox)
					{
						<label for="@field.Id">
							@field.Label
							@if (field.Required)
							{
								<span class="required">*</span>
							}
						</label>
					}

					@switch (field.Type)
					{
						case FormFieldType.Text:
							<input id="@field.Id" name="@field.Id" type="text"
								   placeholder="@field.Placeholder" required="@field.Required" />
							break;

						case FormFieldType.Textarea:
							<textarea id="@field.Id" name="@field.Id" placeholder="@field.Placeholder"
									  required="@field.Required"></textarea>
							break;

						case FormFieldType.Number:
							<input id="@field.Id" name="@field.Id" type="number"
								   min="@field.Minimum" max="@field.Maximum" placeholder="@field.Placeholder"
								   required="@field.Required" />
							break;

						case FormFieldType.Select:
						<select id="@field.Id" name="@field.Id" required="@field.Required">
							<option value="">
								Select an option
							</option>

							@foreach (var option in field.Options)
							{
								<option value="@option.Value">
									@option.Label
								</option>
							}
						</select>
						break;

						case FormFieldType.Checkbox:
						<label class="checkbox-field">
							<input id="@field.Id" name="@field.Id" type="checkbox" />
							<span>
								@field.Label
								@if (field.Required)
								{
									<span class="required">*</span>
								}
							</span>
						</label>
						break;

						case FormFieldType.Radio:
						<fieldset>
							<legend>
								@field.Label

								@if (field.Required)
								{
									<span class="required">*</span>
								}
							</legend>

							@foreach (var option in field.Options)
							{
								<label class="radio-field">
									<input type="radio" name="@field.Id" value="@option.Value"
										   required="@field.Required" />
									<span>
										@option.Label
									</span>
								</label>
							}
						</fieldset>
						break;
					}

					@if (!string.IsNullOrWhiteSpace(field.HelpText))
					{
						<div class="help-text">
							@field.HelpText
						</div>
					}

				</div>
			}

			<button type="submit" class="button button-primary">
				@Model.SubmitText
			</button>
		</form>

		<section id="form-result" class="result-panel" hidden>
			<h2>Response</h2>
			<pre id="form-result-content"></pre>
		</section>
	</main>
	<script src="/assets/site.js"></script>
</body>
</html>