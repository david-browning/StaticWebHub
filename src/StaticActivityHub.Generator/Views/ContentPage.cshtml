@model StaticActivityHub.Generator.Models.ContentPage
@using StaticActivityHub.Generator.Models

<!DOCTYPE html>
<html lang="@Model.Locale">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@Model.PageType</title>
	<link rel="stylesheet" href="/assets/site.css" />
</head>
<body>

	<header class="site-header">
		<div class="shell">
			<div class="page-type">Content</div>
			<h1>@Model.PageType</h1>
			@if (!string.IsNullOrWhiteSpace(Model.Subtitle))
			{
				<p class="subtitle">
					@Model.Subtitle
				</p>
			}
		</div>
	</header>

	<main class="shell page-content">
		@if (!string.IsNullOrWhiteSpace(Model.Description))
		{
			<p class="page-description">
				@Model.Description
			</p>
		}

		<article class="content-document">
			@Html.Raw(Model.RenderedContent)
		</article>
	</main>
</body>
</html>