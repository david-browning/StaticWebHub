@model StaticActivityHub.Generator.Models.RedirectPage

<!DOCTYPE html>
<html lang="@Model.Locale">
<head>
	<meta charset="utf-8" />
	<meta http-equiv="refresh" content="0; url=@Model.Destination" />
	<meta name="robots" content="noindex" />
	<title>@Model.PageType</title>
	<link rel="stylesheet" href="/assets/site.css" />
</head>
<body>
	<main class="shell redirect-page">
		<div class="redirect-card">
			<div class="page-type">
				Redirect
			</div>

			<h1>@Model.PageType</h1>

			<p>
				This page has moved.
			</p>

			<p>
				<a class="button button-primary" href="@Model.Destination">
					Continue
				</a>
			</p>

			<div class="technical-note">
				Redirect preference:
				@(Model.Permanent ? "Permanent" : "Temporary")
			</div>

		</div>

	</main>
</body>
</html>